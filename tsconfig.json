{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "out",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "typeRoots": ["./node_modules/@types", "./"],
    "types": ["node", "vscode", "mocha"]
  },
